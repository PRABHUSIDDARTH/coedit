# Do not copy this by hand: run `make env`, which writes .env with random secrets (never printed).
# The secret values below are deliberately empty so a hand-copied file fails to start
# (docker-compose.yml refuses an empty POSTGRES_PASSWORD; the API refuses empty/short secrets).
POSTGRES_USER=coedit
POSTGRES_PASSWORD=
POSTGRES_DB=coedit

# Session cookie JWT signing key
APP_SECRET=
# Shared between api (mints) and sync (verifies) for WebSocket tickets
WS_TICKET_SECRET=
# 32 bytes, base64 — AES-256-GCM master key for provider API keys
KEY_ENCRYPTION_KEY=

# Web origin allowed by CORS and used for cookie settings
WEB_ORIGIN=http://localhost:5173

# Council
COUNCIL_FAKE=0
COUNCIL_MODEL_ANTHROPIC=claude-sonnet-5-5
COUNCIL_MODEL_OPENAI=gpt-6.1-terra
COUNCIL_MODEL_GOOGLE=gemini-3.8-flash

# Host port for Postgres (container is always 5432)
DB_PORT=5433

# OpenAI-compatible seats (Groq, NVIDIA NIM, Ollama, ...). Presets are endpoints only; the model
# and its price are chosen per seat in the Council panel.
# MUST stay 0 in any hosted / multi-user deployment: 1 lets a seat point at private, loopback and
# link-local addresses and at any host (Ollama on this machine, a LAN server) = SSRF into your network.
COUNCIL_ALLOW_LOCAL_PROVIDERS=0
# Extra presets (JSON), e.g. {"together": {"label": "Together", "base_url": "https://api.together.xyz/v1"}}
COUNCIL_PROVIDER_PRESETS=

# Blob storage: "local" (default, the /data/blobs volume) or "nexuscloud" (experimental, only tested
# against a stub). NexusCloud needs a service token; see README "Optional: NexusCloud storage".
STORAGE_BACKEND=local
NEXUSCLOUD_BASE_URL=
NEXUSCLOUD_TOKEN=
# MUST stay 0 in any hosted deployment: 1 allows plain http and private/loopback addresses.
NEXUSCLOUD_ALLOW_PRIVATE=0

# Login / register rate limits: in-memory, per API process (reset on restart, not shared between
# replicas). 0 disables a limit. Every attempt counts, per client IP and per email.
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_IP_MAX=30
RATE_LIMIT_EMAIL_MAX=8
# 1 = take the client IP from the last X-Forwarded-For entry. Only behind a proxy that sets it;
# otherwise anyone can pick their own bucket. Without it, behind the bundled web proxy, every
# user shares the web container's address for the per-IP limit.
RATE_LIMIT_TRUST_FORWARDED=0

# Session lifetime (JWT exp and cookie max-age). Logout only clears the cookie: a copied token stays
# valid until it expires, because there is no server-side revocation list.
SESSION_TTL_HOURS=24

# Sync server limits. MAX_MESSAGE_BYTES caps one WebSocket message (one Yjs update or initial sync;
# larger frames are closed with 1009), NOT the total document size. MAX_CONNECTIONS_PER_DOC: 0 = no limit.
MAX_MESSAGE_BYTES=8388608
MAX_CONNECTIONS_PER_DOC=50
